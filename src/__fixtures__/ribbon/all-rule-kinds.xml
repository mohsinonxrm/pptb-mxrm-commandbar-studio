<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixture: all-rule-kinds.xml
  Purpose: Exercises every RuleStep kind supported by the parser/generator.
  Used by: xmlParser.test.ts round-trip tests.
  Valid against RibbonCore.xsd / RibbonTypes.xsd (#42): every rule sits in a
  rule type that allows it (EnableRulesGroup / DisplayRulesGroup), and the tab
  has its <Scaling> before <Groups>, as in RetrieveEntityRibbon output.
-->
<RibbonDefinitions>
  <RibbonDefinition>
    <UI>
      <Ribbon>
        <Tabs Id="Mscrm.Tabs">
          <Tab Id="TestTab" Title="Test" Sequence="10" Command="TestTab.Command">
            <Scaling Id="TestTab.Scaling">
              <MaxSize Id="TestGroup.MaxSize" GroupId="TestGroup" Sequence="10" Size="LargeLarge"/>
            </Scaling>
            <Groups Id="TestTab.Groups">
              <Group Id="TestGroup" Title="Test Group" Sequence="10" Template="Mscrm.Templates.Flexible2">
                <Controls Id="TestGroup.Controls">
                  <Button Id="TestButton" LabelText="Test Button" TemplateAlias="o1"
                          Sequence="10"/>
                </Controls>
              </Group>
            </Groups>
          </Tab>
        </Tabs>
        <ContextualTabs Id="Mscrm.ContextualTabs"/>
      </Ribbon>
    </UI>
    <!-- No CommandDefinitions: the fixture only tests rule step parsing —
         command wiring is tested via the account-full fixture. -->
    <RuleDefinitions>
      <!-- TabDisplayRules live HERE, not inside <Tab> elements. -->
      <TabDisplayRules>
        <TabDisplayRule TabCommand="TestTab.Command">
          <EntityRule AppliesTo="PrimaryEntity" Context="HomePageGrid"/>
          <PageRule Address="http://example.com/testpage"/>
        </TabDisplayRule>
      </TabDisplayRules>

      <DisplayRules>
        <!-- DisplayRule: every kind of DisplayRulesGroup CBS models -->
        <DisplayRule Id="TestDisplayRule">
          <!-- Display-only kinds -->
          <EntityPrivilegeRule PrivilegeType="Read" PrivilegeDepth="Basic"
                               AppliesTo="PrimaryEntity" EntityName="account"/>
          <EntityPropertyRule PropertyName="HasNotes" PropertyValue="true"
                              AppliesTo="PrimaryEntity"/>
          <DeviceTypeRule Type="Web" InvertResult="false"/>
          <OptionSetRule OptionSet="statuscode" StateCode="1" ObjectTypeCode="1"/>
          <FormEntityContextRule EntityName="account"/>
          <RelationshipTypeRule AppliesTo="SelectedEntity" RelationshipType="OneToMany"
                                AllowCustomRelationship="true" AllowSystemRelationship="false"/>
          <ReferencingAttributeRequiredRule/>
          <OutlookRenderTypeRule Type="Outlook"/>
          <CrmOutlookClientVersionRule Major="15" Minor="0" Build="0" Revision="0"/>
          <HideForTabletExperienceRule/>
          <MiscellaneousPrivilegeRule PrivilegeName="ExportToExcel"/>
          <OrganizationSettingRule Setting="IsSharepointEnabled"/>
          <FormTypeRule Type="Main"/>
          <FeatureControlRule FeatureControlBit="FCB.TestFeature" ExpectedValue="true"/>
          <!-- Shared kinds (valid in both Enable and Display) -->
          <PageRule Address="http://example.com/page"/>
          <FormStateRule State="Existing"/>
          <CommandClientTypeRule Type="Refresh" Default="true"/>
          <CrmClientTypeRule Type="Web"/>
          <OutlookVersionRule Version="2010"/>
          <SkuRule Sku="Online"/>
          <ValueRule Field="statuscode" Value="1"/>
          <EntityRule EntityName="account" AppliesTo="PrimaryEntity" Context="Form"/>
          <CrmOfflineAccessStateRule State="Online"/>
          <CrmOutlookClientTypeRule Type="CrmForOutlook"/>
          <!-- OrRule (min 2 Or children per schema) -->
          <OrRule>
            <Or><EntityRule EntityName="account"/></Or>
            <Or><FormTypeRule Type="Quick"/></Or>
          </OrRule>
        </DisplayRule>
      </DisplayRules>

      <EnableRules>
        <!-- EnableRule: only EnableRulesGroup kinds are valid per schema -->
        <EnableRule Id="TestEnableRule">
          <SelectionCountRule Minimum="1" AppliesTo="SelectedEntity"/>
          <EntityRule EntityName="contact" AppliesTo="PrimaryEntity" Context="Form"/>
          <FormStateRule State="Existing"/>
          <CommandClientTypeRule Type="Legacy"/>
          <CrmClientTypeRule Type="Web"/>
          <CustomRule Library="$webresource:test_/rules.js"
                      FunctionName="TestRules.checkEnable" Default="false"/>
          <RecordPrivilegeRule PrivilegeType="Read" AppliesTo="PrimaryEntity"/>
          <OutlookItemTrackingRule TrackedInCrm="false"/>
          <OutlookVersionRule Version="2007"/>
          <PageRule Address="http://example.com/enable"/>
          <SkuRule Sku="OnPremise" InvertResult="true"/>
          <ValueRule Field="statecode" Value="0"/>
          <CrmOfflineAccessStateRule State="Offline"/>
          <CrmOutlookClientTypeRule Type="CrmForOutlookOfflineAccess"/>
          <OrRule>
            <Or><SelectionCountRule Minimum="1"/></Or>
            <Or><EntityRule EntityName="contact"/></Or>
          </OrRule>
        </EnableRule>
      </EnableRules>
    </RuleDefinitions>
    <LocLabels>
      <LocLabel Id="TestButton.LabelText">
        <Titles>
          <Title languagecode="1033" description="Test Button"/>
        </Titles>
      </LocLabel>
    </LocLabels>
  </RibbonDefinition>
</RibbonDefinitions>
