{
	"compilerOptions": {
		"composite": true,
		/* Type-check only. Referenced projects must allow emit, so we emit
       declarations into a git-ignored cache folder instead of next to the
       sources (Vite would otherwise pick up a stale vite.config.js). */
		"emitDeclarationOnly": true,
		"outDir": "./node_modules/.tmp/tsconfig.node",
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"isolatedModules": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["vite.config.ts", "vitest.config.ts"]
}
